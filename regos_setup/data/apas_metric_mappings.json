{
  "_comment": "Maps APAS Telemetry API metric names to RegOS Chapter 24 threshold parameters. Only mapped metrics are evaluated for compliance. Add new mappings as sensors are deployed.",
  "_version": "1.0.0",
  "mappings": [
    {
      "apas_source_id": "123scada_pump_station",
      "apas_metric": "wetwell.*.level",
      "regos_parameter": null,
      "regos_unit": null,
      "description": "Wet well water level — no direct Chapter 24 threshold. Monitored for operational awareness only.",
      "evaluate": false
    },
    {
      "apas_source_id": "123scada_pump_station",
      "apas_metric": "rtu.*.temperature",
      "regos_parameter": "Temperature",
      "regos_unit": "°F",
      "unit_conversion": {
        "from": "°C",
        "to": "°F",
        "formula": "value * 9/5 + 32"
      },
      "description": "RTU temperature — evaluated against Chapter 24 discharge temperature limits (92°F freshwater, 95°F marine). APAS reports in °C, converted to °F for threshold check.",
      "evaluate": true
    },
    {
      "apas_source_id": "123scada_pump_station",
      "apas_metric": "rtu.*.ac",
      "regos_parameter": null,
      "regos_unit": null,
      "description": "RTU AC voltage — operational metric, no Chapter 24 threshold.",
      "evaluate": false
    },
    {
      "apas_source_id": "123scada_pump_station",
      "apas_metric": "rtu.*.battery",
      "regos_parameter": null,
      "regos_unit": null,
      "description": "RTU battery voltage — operational metric, no Chapter 24 threshold.",
      "evaluate": false
    },
    {
      "apas_source_id": "123scada_pump_station",
      "apas_metric": "pump.*.running",
      "regos_parameter": null,
      "regos_unit": null,
      "description": "Pump running state (0/1) — operational, no Chapter 24 threshold.",
      "evaluate": false
    },
    {
      "apas_source_id": "123scada_pump_station",
      "apas_metric": "pumpstation.*.state",
      "regos_parameter": null,
      "regos_unit": null,
      "description": "Station state code — operational, no Chapter 24 threshold.",
      "evaluate": false
    },
    {
      "apas_source_id": "123scada_pump_station",
      "apas_metric": "pumpstation.*.ac_fail",
      "regos_parameter": null,
      "regos_unit": null,
      "description": "AC failure flag — operational, no Chapter 24 threshold.",
      "evaluate": false
    },
    {
      "apas_source_id": "123scada_pump_station",
      "apas_metric": "pumpstation.*.is_online",
      "regos_parameter": null,
      "regos_unit": null,
      "description": "Online status — operational, no Chapter 24 threshold.",
      "evaluate": false
    }
  ],
