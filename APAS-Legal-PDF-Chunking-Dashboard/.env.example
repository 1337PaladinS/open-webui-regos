# Export directory — where chunk exports land on the host filesystem
# Set this to any path on your machine before running docker compose up
EXPORT_PATH=./exports

# Neo4j Configuration
# NEO4J_MODE: "internal" (bundled container) or "external" (your own instance)
NEO4J_MODE=external
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# LLM for contextual prefix generation
OPENROUTER_API_KEY=sk-or-your-key-here
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1
