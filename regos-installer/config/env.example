# .env — Local overrides (copy to .env and fill in)
# This file is NOT committed to git.

# Required: Your Open WebUI API token
# Get it from: Open WebUI → Profile → Settings → Account → API Keys
OPENWEBUI_TOKEN=

# Optional overrides
# CONTAINER_NAME=open-webui
# OPENWEBUI_URL=https://<your-openwebui-host>   # e.g. https://eqcb.apas.ai
# VERBOSE=true
# CREATE_MODEL=true
# SETUP_GROUPS=false
# GROUP_MEMBERS=hardeep@apas.ai,anmol@apas.ai
