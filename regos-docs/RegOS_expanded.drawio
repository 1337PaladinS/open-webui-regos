        <mxCell id="apas-startup-txt" parent="apas-v2-group" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=light-dark(#ffffff, #e9e9e9);spacingLeft=5;spacingTop=2;" value="&lt;b&gt;1.&lt;/b&gt; neo4j → ready (cypher health check)&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; timescaledb → ready (pg_isready)&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; loader → parse OWL → MERGE → exit&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; api lifespan: Init TimescaleDB/SQLite schema,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;seed admin, init anomaly/AI engines,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;start SCADA poller, geo cache refresh&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; visualizer → serves static build" vertex="1">
          <mxGeometry height="165" width="380" x="85" y="1455" as="geometry" />
        </mxCell>
        <mxCell id="apas-security" parent="apas-v2-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=light-dark(#FFFFFF,#4E9E72);strokeWidth=1;fontSize=10;fontColor=light-dark(#ffffff, #e9e9e9);align=center;verticalAlign=top;spacingTop=5;arcSize=5;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size:11px&quot;&gt;Security Architecture&lt;/b&gt;" vertex="1">
          <mxGeometry height="200" width="400" x="490" y="1425" as="geometry" />
        </mxCell>
        <mxCell id="apas-security-txt" parent="apas-v2-group" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=light-dark(#ffffff, #e9e9e9);spacingLeft=5;spacingTop=2;" value="&lt;b&gt;Auth:&lt;/b&gt; bcrypt (12 rounds) + HS256 JWT&lt;br&gt;&lt;b&gt;Headers:&lt;/b&gt; CSP default-src &#39;self&#39; | HSTS 1yr | X-Frame DENY&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Pydantic validation | parameterized SQL&lt;br&gt;&lt;b&gt;Rate limit:&lt;/b&gt; Per-IP sliding window 60s&lt;br&gt;&lt;b&gt;Secrets:&lt;/b&gt; JWT_SECRET_KEY, NEO4J_PASSWORD, etc.&lt;br&gt;&lt;b&gt;Dedup:&lt;/b&gt; SHA-256 fingerprint + UNIQUE constraints&lt;br&gt;&lt;b&gt;Audit:&lt;/b&gt; auth_audit_log (SQLite)" vertex="1">
          <mxGeometry height="165" width="380" x="500" y="1455" as="geometry" />
        </mxCell>
